{
  "env": {
    "es2021": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2018,
    "sourceType": "module"
  },
  "plugins": ["wdio"],
  "extends": ["eslint:recommended", "plugin:wdio/recommended", "plugin:prettier/recommended"],
  "rules": {
    "wdio/no-pause": "warn",
    "linebreak-style": ["error", "unix"],
    "semi": ["error", "always"],
    "prettier/prettier": ["warn", { "singleQuote": true, "printWidth": 120 }],
    "quotes": ["warn", "single", { "avoidEscape": true }]
  }
}
