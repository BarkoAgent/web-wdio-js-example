{
  "name": "web-wdio-js-example",
  "version": "1.0.0",
  "description": "Example WebdriverIO + Cucumber (JavaScript) web test automation framework, run against the public Practice Software Testing demo shop. Training material for the Test Automation with AI Agents & BarkoAgent course.",
  "type": "module",
  "scripts": {
    "test": "npx wdio run ./config/wdio.conf.js",
    "test:chrome": "npx wdio run ./config/wdio.conf-chrome.js",
    "test:ff": "npx wdio run ./config/wdio.conf-ff.js",
    "linters": "npm run eslint && npm run gherkin-lint",
    "report": "allure generate --clean && allure open",
    "delete-local-report": "npx rimraf ./allure-results && npx rimraf ./allure-report",
    "eslint": "eslint .",
    "gherkin-lint": "npx gherkin-lint -c .gherkin-lintrc.json ./features/*.feature",
    "prereport": "npx run-func ./automation-code/support/report-helper.js reportCleanup",
    "prepare": "husky install"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@wdio/allure-reporter": "^8.39.0",
    "@wdio/cli": "^9.0.7",
    "@wdio/cucumber-framework": "^9.0.6",
    "@wdio/local-runner": "^9.0.7",
    "eslint": "^8.22.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-wdio": "^7.20.8",
    "gherkin-lint": "^4.2.2",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "pretty-quick": "^3.1.3",
    "wdio-eslinter-service": "^0.0.4",
    "wdio-wait-for": "^2.2.6",
    "webdriverio": "^9.0.7"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "deepmerge": "^4.2.2",
    "dotenv": "^18.0.5"
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  },
  "keywords": [
    "test-automation",
    "webdriverio",
    "cucumber",
    "allure",
    "example",
    "barkoagent",
    "ai-agents"
  ]
}
